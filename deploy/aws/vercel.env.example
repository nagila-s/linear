# Variaveis no painel Vercel (Production + Preview)

# Login do site
ACCESS_PASSWORD=
SESSION_SECRET=

# Modo manutencao: 1 bloqueia o site inteiro (503), inclusive login e /api. Apagar ou 0 para voltar.
# Mudar exige publicar de novo na Vercel.
MAINTENANCE_MODE=0

# Area de testes serverless (/testes) — obrigatorio
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# BFF producao linearizacao (tela principal) — opcional para /testes
FASTAPI_URL=https://api.seudominio.com
# Mesma chave configurada na API (ECS). Só servidor: nunca NEXT_PUBLIC_.
LINEAR_API_KEY=
NEXT_PUBLIC_API_PREFIX=/api/v1
