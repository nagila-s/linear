# Variaveis para o servico ECS linear-worker (sem porta HTTP).

APP_ENV=production

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_DSN=

BUCKET_PDF=pdf
BUCKET_PAGES=pages
BUCKET_FIGURES=figures
BUCKET_JSON=json

OPENAI_API_KEY=
OPENAI_MODEL_LINEARIZATION=gpt-6.1-terra
OPENAI_MODEL_CONTEXT=gpt-6.1-terra
OPENAI_MODEL_CLASSIFIER=gpt-6-luna
TEXT_GAP_FILL_ENABLED=true
TEXT_GAP_FILL_MAX_OUTPUT_TOKENS=16384
OPENAI_PREFER_RESPONSES_API=true
OPENAI_REASONING_EFFORT=none
LINEARIZE_MAX_OUTPUT_TOKENS=128000
PROMPT_ROUTING_ENABLED=true
PROMPTS_DIRECTORY=prompts
CLASSIFICATION_WINDOW_START=20
CLASSIFICATION_WINDOW_END=15
CLASSIFIER_MAX_OUTPUT_TOKENS=4096
LINEAR_PIPELINE_ONLY=false
PDF_RENDER_DPI=200
PDF_RENDER_BATCH_SIZE=10
# legacy | v3 (extrator de figuras novo). Um job escolhe o seu em metadata.figure_extractor.
PDF_FIGURE_EXTRACTOR=legacy
LINEARIZE_PAGE_CONCURRENCY=4
DORINA_PAGE_CONCURRENCY=3

PDF_STORAGE_STRATEGY=supabase
PDF_MAX_SIZE_MB=1024
PROCESS_VERSION_STRATEGY=lin-{linear_prompt_version}

WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_JOB_MINUTES=120

DORINA_API_URL=
DORINA_API_KEY=
DORINA_API_KEY_HEADER=Authorization
DORINA_DOCUMENT_TYPE=string
DORINA_BRAILLE=false
DORINA_SIGNED_URL_EXPIRES_SECONDS=3600
DORINA_TIMEOUT_SECONDS=60
